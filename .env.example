# PokéCast environment. Copy to .env.local for development; set the same keys in Vercel → Settings → Environment Variables.

# ── Network ─────────────────────────────────────────────
# bsc (mainnet) | bscTestnet | localhost (Hardhat)
NEXT_PUBLIC_CHAIN=bsc
# Optional dedicated RPC (recommended in production, e.g. a NodeReal/QuickNode BSC endpoint)
NEXT_PUBLIC_BSC_RPC_URL=
BSC_RPC_URL_SERVER=

# USDT (BEP-20). Leave empty on mainnet to use 0x55d398326f99059fF775485246999027B3197955.
NEXT_PUBLIC_USDT_ADDRESS=
# Treasury wallet: every payment (packs, PokéMart, shipping) is a USDT transfer to it.
# Buybacks, cashback, PokéMart seller payouts and refunds are paid from /admin by an admin wallet.
NEXT_PUBLIC_TREASURY_ADDRESS=

# ── Public links ────────────────────────────────────────
# X (Twitter) profile shown in the top bar, e.g. https://x.com/pokecast (https only; empty = hidden)
NEXT_PUBLIC_X_URL=
# Token contract address shown as "CA:" under the logo, with a copy button (empty = hidden)
NEXT_PUBLIC_CA=

# WalletConnect Cloud project id (needed for mobile wallets via QR)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Server secrets (never NEXT_PUBLIC_) ─────────────────
# Neon Postgres connection string (Vercel → Storage → Neon adds it automatically). Empty = local PGlite.
DATABASE_URL=
# 32+ random characters for session cookies
SESSION_SECRET=
# Comma-separated wallets that can open /admin
ADMIN_ADDRESSES=
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
